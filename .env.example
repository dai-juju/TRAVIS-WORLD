# ============================================================================
# TRAVIS 환경 변수 템플릿
# ============================================================================
# 이 파일은 자리 표시용입니다. 실제 값은 커밋하지 마세요.
#
# 실제 값은 두 곳에 나눠서 넣습니다 (.gitignore에 의해 커밋 제외):
#   • apps/web/.env.local   ← Next.js 프론트엔드 + API Route
#   • apps/worker/.env      ← Hetzner 데이터 수집 워커 (Node.js)
#
# 키 발급 위치:
#   • Supabase: 대시보드 → Project Settings → API
#   • Anthropic: https://console.anthropic.com/ → API Keys
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# apps/web/.env.local  (Next.js — 브라우저 노출 가능한 anon key만)
# ─────────────────────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL (공개 OK, NEXT_PUBLIC_ prefix라 브라우저에 노출됨)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase anon 키 (공개 OK, RLS가 권한을 제어)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# Anthropic Claude API 키 (서버 전용, NEXT_PUBLIC_ prefix 금지)
# M1.5 AI 오케스트레이터부터 실제 호출 시작
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxx


# ─────────────────────────────────────────────────────────────────────────────
# apps/worker/.env  (Hetzner 데이터 워커 — service_role 사용, 절대 프론트 노출 금지)
# ─────────────────────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL (위와 동일, prefix 없음)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase service_role 키 — RLS 우회 가능, 서버 전용, 절대 커밋/브라우저 노출 금지
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...
