# ============================================================================
# TRAVIS Worker Environment Variables (template)
# ----------------------------------------------------------------------------
# 실제 값을 채운 뒤 /etc/travis/worker.env 로 업로드 (scp).
# 권한: root:travis 0640 (root 만 write, travis 그룹만 read).
# 절대 git 에 commit 하지 말 것 (.gitignore 가 .env* 차단).
# 발급 위치:
#   • Supabase: 대시보드 → Project Settings → API
# ============================================================================

# 운영 모드 (production / development)
NODE_ENV=production

# 로그 상세도 (debug / info / warn / error)
WORKER_LOG_LEVEL=info

# Supabase 프로젝트 URL — apps/web 의 NEXT_PUBLIC_SUPABASE_URL 과 동일 값
SUPABASE_URL=

# Supabase service_role 키 (RLS 우회) — 절대 브라우저/git 노출 금지
# 발급 위치: Supabase 대시보드 → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# (옵션) Binance API key — 현재 사용 안 함 (public REST/WS 모드, rate limit 1200/min)
# 베타 사용자 100명+ 도달 또는 M2 다거래소 시 발급 권장
# 발급 위치: https://www.binance.com/en/my/settings/api-management (read-only 권한만)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
