{
  "name": "@travis/worker",
  "version": "0.0.0",
  "private": true,
  "description": "TRAVIS Hetzner 데이터 수집 워커 + WS 릴레이 (Node.js TS 뼈대).",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "smoke": "tsx --env-file=.env src/scripts/smokeDataService.ts",
    "smoke:binance": "tsx --env-file=.env src/scripts/smokeBinance.ts",
    "smoke:step5": "tsx --env-file=.env src/scripts/smokeStep5.ts",
    "smoke:ws-server": "tsx src/scripts/smokeWsServer.ts",
    "verify:step4": "tsx --env-file=.env src/scripts/verifyStep4.ts",
    "verify:step5": "tsx --env-file=.env src/scripts/verifyStep5.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2",
    "@travis/data-service": "workspace:*",
    "@travis/exchange-collectors": "workspace:*",
    "@travis/shared": "workspace:*",
    "jose": "^6.2.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "eslint": "^9.36.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.1"
  }
}
