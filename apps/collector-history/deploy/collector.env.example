# ============================================================================
# TRAVIS Collector-History Environment Variables (template)
# ----------------------------------------------------------------------------
# 실제 값을 채운 뒤 /etc/travis/collector.env 로 업로드 (scp).
# 권한: root:travis 0640 (root 만 write, travis 그룹만 read).
# 절대 git 에 commit 하지 말 것 (.gitignore 가 .env* 차단).
#
# ⚠️ 이 수집기는 production worker 와 **별도 Hetzner 서버(별도 IP)** 에서 실행해야 함.
#    같은 IP 에서 돌리면 Binance /futures/data IP quota 충돌 → -1003 ban (M1.9 근거).
# ============================================================================

# 운영 모드 (production / development)
NODE_ENV=production

# 로그 상세도 (debug / info / warn / error)
WORKER_LOG_LEVEL=info

# Supabase 프로젝트 URL — production worker 와 동일 값
SUPABASE_URL=

# Supabase service_role 키 (RLS 우회) — 절대 브라우저/git 노출 금지
# 발급 위치: Supabase 대시보드 → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# (옵션) forward-fill REST rate (req/min). 미설정 시 코드 기본값(150).
# 별도 IP 라 /futures/data IP quota(1000 req/5min) 를 단독 사용 → 여유 있게 조정 가능.
# FORWARD_FILL_REQ_PER_MIN=150
