{
  "name": "@travis/web",
  "version": "0.0.0",
  "private": true,
  "description": "TRAVIS 프론트엔드 + AI 오케스트레이터 API Route (Next.js 16 App Router).",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:haiku": "tsx --env-file=.env.local scripts/smoke-haiku.ts",
    "smoke:orchestrate": "tsx --env-file=.env.local scripts/smoke-orchestrate.ts",
    "spike:tool-use": "tsx --env-file=.env.local scripts/spike-tool-use.ts",
    "smoke:log-failure": "tsx --env-file=.env.local scripts/smoke-log-failure.ts",
    "smoke:query-log": "tsx --env-file=.env.local scripts/query-log-validation.ts",
    "e2e": "playwright test",
    "e2e:offline": "cross-env SKIP_LIVE_E2E=1 playwright test",
    "e2e:force-invalid": "cross-env FORCE_INVALID_RESPONSE=true playwright test -g \"\\(B\\)\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2",
    "@travis/data-service": "workspace:*",
    "@travis/shared": "workspace:*",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "^16.2.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.73.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.2.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.1"
  }
}
